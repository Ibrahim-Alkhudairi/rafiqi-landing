# Apache settings for rafiqi.sa on Bluehost. The site is plain files;
# these rules do what the Next.js server used to.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Dot files (like the FTP upload's .ftp-deploy-sync-state.json) are not for visitors.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www is a CNAME to rafiqi.sa: send it to the bare domain over HTTPS in one hop.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # HTTPS only, except Bluehost's certificate checks under /.well-known/. HTTPS
  # may end in front of Apache, so a request counts as HTTPS if either says so.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # The home page is the Arabic page.
  RewriteRule ^$ /ar/ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"

  # Build files have a content hash in their names, so they never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages change with every deploy.
  <ElseIf "%{REQUEST_URI} =~ m#(/|\.html|\.txt)$#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>
